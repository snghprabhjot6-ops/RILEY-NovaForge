# Copy this file to .env and adjust values for your computer.
# Do not place API keys, passwords, or other credentials in committed files.

RILEY_BACKEND=local
RILEY_LANGUAGE=en
RILEY_VOICE_ENABLED=true
RILEY_VOICE_NAME=Samantha
RILEY_SPEECH_ENGINE=sphinx
RILEY_HISTORY_FILE=.riley/history.json
RILEY_LOG_LEVEL=INFO

# Optional: choose RILEY_BACKEND=ollama for full local AI conversations.
RILEY_OLLAMA_URL=http://127.0.0.1:11434
RILEY_OLLAMA_MODEL=llama3.2
